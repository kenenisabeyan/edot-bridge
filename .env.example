# Database Connections (Prisma)
# Supabase PostgreSQL connection URI:
DATABASE_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres"

# Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# NextAuth Settings
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-secret-key-32-chars-long"

# OpenAI Settings
OPENAI_API_KEY="your-openai-api-key-here"
